# --- Firebase Web SDK Configuration (Required) -----------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Admin Superuser Email Whitelist (Comma-separated) ---------------------
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com

# --- Apps Script Drive Uploader (Optional) ---------------------------------
# APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec
# APPS_SCRIPT_SECRET=your-secret
# GOOGLE_FOLDER_ID=12YdI2qtc50Lw0B6d54ZYfC0uPDjaoryL

# --- Reminder Email Options ------------------------------------------------
REMINDER_EMAIL_TO=
