rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Anyone signed in (= staff) can read; only authenticated server-side
      // code (Cloud Function with custom token) writes PDF blobs in v2.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
